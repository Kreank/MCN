# =============================================================================
# MCN — Umgebungsvariablen für den Container-Stack
# =============================================================================
# Kopieren nach deploy/.env und ausfüllen. deploy/.env gehört NICHT ins Repo
# (.gitignore: `.env`) und NICHT ins Image — sie wird zur Laufzeit eingelesen.
#
# Secrets auf dem SERVER erzeugen, nicht hier eintippen und nicht aus einem Chat
# kopieren:
#
#   MCN_SECRET_KEY      openssl rand -base64 48
#   MCN_DB_PASSWORD     openssl rand -base64 24
#   MCN_MINIO_SECRET_KEY  openssl rand -base64 24
#   MCN_DEMO_PASSWORD   frei wählbar, mind. 12 Zeichen (die Chefs tippen es)
#
# =============================================================================


# --- Domain & TLS ------------------------------------------------------------
# Der Name, unter dem die Demo erreichbar ist. Er muss per DNS auf diesen Server
# zeigen, BEVOR certbot ein Zertifikat holen kann.
MCN_DOMAIN=demo.beispiel-firma.de
# Adresse für die Ablaufwarnungen von Let's Encrypt.
MCN_CERTBOT_EMAIL=it@beispiel-firma.de

# Nur ändern, wenn 80/443 auf dem Server belegt sind (dann braucht es aber einen
# vorgelagerten Proxy — und die IP-Allowlist unten wird wertlos, siehe
# docs/deployment.md).
# MCN_HTTP_PORT=80
# MCN_HTTPS_PORT=443

# Steht der Stack HINTER einem vorgelagerten TLS-Proxy (Caddy/Traefik), der auf
# 80/443 terminiert und per HTTP an MCN_HTTP_PORT weiterreicht: auf 1 setzen.
# Dann reicht der MCN-nginx dessen X-Forwarded-Proto (nur der Wert "https") an
# Django durch — sonst hielte Django jede Anfrage für unverschlüsselt und
# CSRF/Secure-Cookies brächen den Login. Der certbot-Container bleibt in diesem
# Betrieb ungenutzt (TLS macht der vorgelagerte Proxy). Achtung: die
# /admin/-IP-Allowlist sieht dann nur noch die Proxy-IP — Basic-Auth ist Pflicht.
# MCN_TRUST_FORWARDED_PROTO=1


# --- Django ------------------------------------------------------------------
# NIEMALS den Default aus settings.py („django-insecure-…") übernehmen: aus dem
# SECRET_KEY werden Sitzungen und Passwort-Reset-Token abgeleitet.
MCN_SECRET_KEY=HIER_EIN_ERZEUGTES_GEHEIMNIS_EINSETZEN

# MCN_DEBUG bleibt AUS (fail-safe). Nicht auf 1 setzen — daran hängen die
# Secure-Flags der Cookies und die Ausgabe von Stacktraces an den Browser.
MCN_DEBUG=0

# Ohne den Domainnamen antwortet Django mit „Bad Request (400)".
MCN_ALLOWED_HOSTS=demo.beispiel-firma.de
# Für POST/PUT/DELETE aus dem Browser. Mit https:// und ohne abschließenden /.
MCN_CSRF_TRUSTED_ORIGINS=https://demo.beispiel-firma.de

# Das Frontend liegt hinter demselben nginx (same-origin) — CORS wird nicht
# gebraucht. Der Wert existiert nur, damit der Dev-Default (localhost:4200) nicht
# stehen bleibt.
MCN_CORS_ORIGINS=https://demo.beispiel-firma.de

# Basis-URL für den Link in der Passwort-vergessen-Mail.
MCN_FRONTEND_BASE_URL=https://demo.beispiel-firma.de

# Wird von docker-compose.yml gesetzt (nginx terminiert TLS). Hier nur zur
# Dokumentation — nicht anfassen.
# MCN_BEHIND_TLS_PROXY=1


# --- Datenbank ---------------------------------------------------------------
# Host/Port setzt docker-compose (postgres:5432). Name/Benutzer/Passwort gelten
# für BEIDE Seiten: Postgres legt die Datenbank damit an, Django verbindet sich
# damit.
MCN_DB_NAME=mcn
MCN_DB_USER=mcn
MCN_DB_PASSWORD=HIER_EIN_ERZEUGTES_PASSWORT_EINSETZEN


# --- Objektspeicher (MinIO) --------------------------------------------------
# Hier liegen Beleg-PDFs, Baustellenfotos und KUNDENUNTERSCHRIFTEN. Der Endpoint
# wird von docker-compose gesetzt (http://minio:9000, kein Port nach außen).
MCN_MINIO_ACCESS_KEY=mcn-minio
MCN_MINIO_SECRET_KEY=HIER_EIN_ERZEUGTES_PASSWORT_EINSETZEN
MCN_MINIO_BUCKET=mcn-belege
MCN_MINIO_REGION=us-east-1


# --- MAILVERSAND: AUF DER DEMO TOT ------------------------------------------
# Das ist die einzige Aktion im System, die nach außen wirkt. Der Versandpfad ist
# scharf: Rechnung, Angebot und MAHNUNG gehen mit PDF an echte Adressen. Ein
# neugieriger Klick eines Geschäftsführers auf „Mahnung versenden" schickt eine
# ECHTE MAHNUNG.
#
# Zwei Schlösser:
#
# 1. EMAIL_BACKEND auf console. Der GESAMTE Versand des Systems läuft über
#    django.core.mail.get_connection() — Rechnungs-, Angebots- und
#    Mahnungsversand (db_core/services/mail.py) ebenso wie der Passwort-Reset
#    (api/auth.py). Es gibt keinen zweiten Weg nach draußen. Mit dieser
#    Einstellung landet jede Mail im Container-Log:
#      docker compose logs backend | grep -A20 Subject
MCN_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
#
# 2. KEIN MCN_MAIL_KEY. Der Fernet-Schlüssel ist der app-weite
#    Secret-at-rest-Schlüssel (db_core/mail_crypto.py, fail-closed) — er
#    verschlüsselt NICHT NUR das SMTP-Absenderkonto, sondern z. B. auch die
#    IDS-Connect-Händler-Zugangsdaten (db_core/services/anbindung.py). Fehlt er,
#    lässt sich beides nicht speichern. Für die reine Demo leer lassen (der
#    Versand bleibt auch mit Schlüssel tot, s. Punkt 1). Wer IDS-Connect-
#    Zugangsdaten hinterlegen will, MUSS ihn setzen — das schaltet den Mailversand
#    NICHT ein. Schlüssel erzeugen:
#      python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MCN_MAIL_KEY=


# --- Demo-Betrieb ------------------------------------------------------------
# MCN_SEED=1 lässt den Entrypoint den Seed-Befehl laufen (idempotent, bei jedem
# Start). Auf einer echten Installation: 0 (oder ganz weglassen).
MCN_SEED=1
# Welcher Befehl geseedet wird.
#
#   seed_demo      Entwicklerfutter — wirkt vor einem Geschäftsführer wie
#                  fremder Beispielkram.
#   seed_szenario  DER Demo-Datenbestand aus docs/demo-szenario.md (WEG Badensche
#                  Straße, EFH Borm, sechs SHK-Szenarien). Für die Vorführung
#                  hier den Namen eintragen — sonst ändert sich nichts.
MCN_SEED_COMMAND=seed_demo
# Zusätzliche Argumente für den Seed-Befehl (ungequotet, mit Leerzeichen
# getrennt). Für seed_szenario: --mit-passwoertern
MCN_SEED_ARGS=

# Erklärt diese Instanz zur Wegwerf-Demo. NUR damit setzt
# `demo_passwoerter_setzen` überhaupt Passwörter.
MCN_DEMO_INSTANZ=1
# Das Passwort, mit dem sich ALLE Demo-Konten anmelden. Mindestens 12 Zeichen.
# Leer lassen ⇒ keine Passwörter ⇒ niemand kommt in die Demo (die Seed-Befehle
# vergeben Passwörter nur bei DEBUG, und DEBUG ist hier aus).
#
# Die Konten aus seed_demo:
#   admin@mitra-sanitaer.de            (Administration, Django-Superuser)
#   joerg.feldmann@mitra-sanitaer.de   (Geschäftsführung)
#   petra.lindqvist@mitra-sanitaer.de  (Innendienst)
#   timo.kalinski@mitra-sanitaer.de    (Monteur)
MCN_DEMO_PASSWORD=HIER_EIN_DEMO_PASSWORT_EINSETZEN

# Fälligkeiten-Scheduler (Wartung, Prüffristen, Gewährleistung).
MCN_SCHEDULER_HOUR=3
MCN_SCHEDULER_MINUTE=15
MCN_SCHEDULER_TZ=Europe/Berlin
# Auf der Demo sinnvoll: einmal sofort laufen, damit „Was steht an?" nicht bis
# morgen früh leer bleibt.
MCN_SCHEDULER_RUN_ON_START=1


# --- /admin/ — nicht öffentlich ---------------------------------------------
# Das Django-Admin geht an Rechtematrix, Statusautomaten und Vier-Augen-Prinzip
# vorbei; wer drin ist, legt sich einen Superuser an. nginx sperrt es.
#
# Kommaseparierte Adressen/Netze, die durchdürfen. LEER = für JEDEN gesperrt.
#
#   172.16.0.0/12   = Docker-Netze. Damit ist /admin/ NUR vom Server selbst
#                     erreichbar (also über einen SSH-Tunnel), nicht aus dem
#                     Internet: Anfragen von außen behalten ihre echte
#                     Quell-IP und werden abgewiesen.
#   203.0.113.7     = zusätzlich die feste IP des Büros (falls vorhanden).
MCN_ADMIN_ALLOW_IPS=172.16.0.0/12

# Zweites Schloss (empfohlen). Erzeugen mit:
#   docker run --rm httpd:2.4-alpine htpasswd -nbB admin 'DEIN-PASSWORT'
# Ergebnis („admin:$2y$05$…") hier einsetzen, in EINFACHEN Anführungszeichen ist
# nicht nötig — aber die $-Zeichen NICHT verdoppeln.
MCN_ADMIN_BASIC_AUTH=


# --- gunicorn ----------------------------------------------------------------
MCN_GUNICORN_WORKERS=3
MCN_GUNICORN_TIMEOUT=120


# --- Nur für die Testsuite, im Betrieb ohne Bedeutung ------------------------
# MCN_TEST_DB_NAME=      (parallele pytest-Läufe auf getrennten Wegwerf-DBs)
# MCN_DEV_PASSWORD=      (Passwort, das seed_demo NUR bei DEBUG vergibt)
# MCN_ERECHNUNG_DUMP=    (ZUGFeRD-Artefakte für die externe Prüfung ablegen)
# MCN_VERAPDF=           (Pfad zur veraPDF-CLI, PDF/A-Validierung)
# MCN_MUSTANG_JAR=       (Pfad zur Mustang-JAR, Schematron-Validierung)
